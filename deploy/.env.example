# Docker Compose 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env

# 对外 HTTP 端口（浏览器访问 http://<服务器IP>:HTTP_PORT）
HTTP_PORT=8088

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=student_aid_db

# JWT（测试环境务必修改；生产请使用足够长的随机串）
JWT_SECRET=change-me-jwt-secret-for-user-test

# 可选：后端运行环境标识
SAS_APP_ENV=prod

# 可选：认定申请表 PDF 中文字体（默认使用镜像内 Noto Sans SC）
# SAS_EXPORT_PDF_FONT_PATH=/app/assets/fonts/NotoSansSC-Regular.ttf

# 可选：数据备份保留份数（超出后自动删除最旧的，0 表示不限制）
# SAS_BACKUP_MAX_KEEP=20
# 可选：恢复时允许上传的备份文件大小上限（MB）
# SAS_BACKUP_MAX_UPLOAD_MB=1024
