# 环境变量覆盖配置（前缀 SAS_，下划线对应配置层级）
# 复制为 .env 后按需修改，或直接 export 到运行环境。

SAS_APP_ENV=dev
SAS_SERVER_PORT=8080

SAS_DATABASE_DRIVER=postgres
SAS_DATABASE_HOST=127.0.0.1
SAS_DATABASE_PORT=5432
SAS_DATABASE_USER=postgres
SAS_DATABASE_PASSWORD=your_password
SAS_DATABASE_NAME=student_aid

SAS_JWT_SECRET=please-change-this-secret
SAS_JWT_EXPIRE_HOURS=24
SAS_JWT_REFRESH_EXPIRE_HOURS=168

# 附件上传
SAS_UPLOAD_DIR=./uploads
SAS_UPLOAD_MAX_SIZE_MB=20

# 助学金申请表等 fpdf 导出所需的中文字体（TTF 路径），留空则该类导出会提示未配置
SAS_EXPORT_PDF_FONT_PATH=./assets/fonts/NotoSansSC-Regular.ttf
# 认定申请表 Word 模板（docx，含 {占位符}），认定通过后导出 docx 时使用
SAS_EXPORT_RECOGNITION_TEMPLATE_PATH=./assets/templates/recognition_application.docx
# 助学金申请表 Word 模板（docx，含 {占位符}），审批通过后导出 docx 时使用
SAS_EXPORT_GRANT_TEMPLATE_PATH=./assets/templates/grant_national_aid.docx
# 家庭经济困难学生认定结果汇总表 Excel 模板
SAS_EXPORT_RECOGNITION_SUMMARY_TEMPLATE_PATH=./assets/templates/recognition_result_summary.xlsx
